# Architect AI Environment Variables

# AI Providers Settings
# (Optional) Default fallback for standard Gemini routing
GEMINI_API_KEY="your_gemini_api_key_here"

# Allowed Owner Emails (Comma-separated list of Google accounts allowed to access the app)
# Example: ALLOWED_EMAILS="owner@example.com,co-owner@example.com"
ALLOWED_EMAILS="your_email@gmail.com"

# ==========================================
# Firebase Admin — SERVER ONLY
# (DO NOT expose these to the client bundle)
# ==========================================
FIREBASE_ADMIN_PROJECT_ID="your_project_id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==========================================
# Firebase Client Configuration — PUBLIC
# (Obtain these from your Firebase Project Settings -> General -> Web App)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# Omni Configuration
# Omni URL can be configured directly in the frontend UI Settings, but if you want
# a safe server-side fallback without relying on client configuration, set this:
OMNI_API_KEY="sk-or-v1-your_omni_api_key_here"
